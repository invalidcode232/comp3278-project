# MySQL connection. These defaults match docker-compose.yml (MySQL on host port 3307).
# For a local MySQL install, change DB_PORT to 3306 and DB_PASSWORD to your root password.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=change-me
# Must stay comp3278_social: db/schema.sql creates the database with this name.
DB_NAME=comp3278_social

# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false
