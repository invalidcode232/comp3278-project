{
  "name": "comp3278-social",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "COMP3278 social web app: Next.js + MySQL 8 with hand-written SQL",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:schema": "node --env-file=.env scripts/apply-schema.ts",
    "db:seed": "node --env-file=.env scripts/seed.ts",
    "db:reset": "npm run db:schema && npm run db:seed",
    "test:db": "tsx --test tests/database.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "node --env-file=.env scripts/migrate-posts.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "mysql2": "3.24.6",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
